---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Página no encontrada | SunRiver"
  description="Esta página no existe. Vuelve al inicio de SunRiver."
  noindex
>
  <section class="pt-40 pb-24 text-center px-4">
    <h1 class="text-4xl font-bold text-sunriver-blue mb-4">Esta página no existe</h1>
    <p class="text-gray-600 mb-8">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <a href="/" class="inline-block px-6 py-3 bg-sunriver-orange text-white font-semibold rounded-full">Volver al inicio</a>
  </section>
</SiteLayout>
