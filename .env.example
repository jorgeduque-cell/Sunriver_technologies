# ============================================================
# SunRiver Platform - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ============================================================

# -----------------------------------------------------------
# Contact Form - n8n Webhook
# -----------------------------------------------------------
# Production webhook URL for contact form submissions
# Example: https://n8n.sunriver.solutions/webhook/contact-form
VITE_N8N_WEBHOOK_URL=

# -----------------------------------------------------------
# ChatBot - n8n Webhook (Server-side)
# -----------------------------------------------------------
# n8n webhook URL for chatbot conversations
# Create a workflow in n8n with a Webhook trigger and connect your AI agent
# Example: https://n8n.sunriver.solutions/webhook/chatbot
N8N_CHATBOT_WEBHOOK=

# -----------------------------------------------------------
# Optional: Analytics & Monitoring
# -----------------------------------------------------------
# VITE_GA_TRACKING_ID=
# VITE_SENTRY_DSN=

# -----------------------------------------------------------
# Optional: Rate Limiting (Redis/Upstash)
# -----------------------------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
